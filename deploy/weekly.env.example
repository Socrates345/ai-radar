# Copy to radar-data/weekly.env (gitignored) and fill in.
#
# ntfy topic for the weekly AI Radar run alerts (.claude/scripts/weekly.sh and
# deploy/windows/ai-radar.ps1). Use a topic of its own, not scsync's or XtoMD's.
# The topic name works like a password, so make it random:
#   python -c "import secrets; print(secrets.token_hex(16))"
# then subscribe to that topic in the ntfy app. Alerts only ever contain counts
# and fixed wording, never links or tool names.
NOTIFY_URL=https://ntfy.sh/<random topic>
